# Copy to .env.local and fill in. .env.local is gitignored — never commit
# real values, and never put a secret in a NEXT_PUBLIC_ variable.

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Safe in the browser: RLS is what protects the data behind it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS entirely. Never ship to the client and
# never give it to the voice agent — the agent uses an agent_service
# token scoped to one location per call.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ────────────────────────────────────────────────────────
# Reads an uploaded photo or PDF of a menu into structured items for a
# human to confirm (lib/menu-imports/read.ts). Server-side only, and it
# must never gain a NEXT_PUBLIC_ twin: a model key in the browser bundle
# is a key anyone can spend. Without it the read step refuses with a
# sentence saying so; everything else in the app keeps working.
ANTHROPIC_API_KEY=

# ── Twilio ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Verify X-Twilio-Signature on every webhook with this.
TWILIO_WEBHOOK_BASE_URL=

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public base URL Twilio calls. Must match exactly what Twilio signed --
# a mismatch makes every webhook 403. Use your tunnel URL locally.

# ── Vapi ─────────────────────────────────────────────────────────────
# Not read by any code in this repo -- the six app/api/agent/* tool
# endpoints and the assistant-config endpoint authenticate with a
# per-location secret (x-dialtone-secret, see scripts/set-agent-secret.mjs),
# not with these. Vapi assistants are wired by hand today, through the
# Vapi dashboard and API directly -- see docs/vapi-setup.md. Kept here so
# the private key and the assistant id have one obvious place to live if
# that wiring is ever scripted. Server-side only if it is ever read --
# never a NEXT_PUBLIC_ variable.
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
